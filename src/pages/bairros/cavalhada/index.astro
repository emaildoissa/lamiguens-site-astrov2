---
import Layout from '@/layouts/Layout.astro'
import GoldDivider from '@/components/GoldDivider.astro'
const services = [
  { name: 'Fisioterapia Ortopédica', href: '/servicos/fisioterapia-ortopedica' },
  { name: 'Fisioterapia Pós-Operatória', href: '/servicos/fisioterapia-pos-operatoria' },
  { name: 'Fisioterapia Domiciliar', href: '/servicos/fisioterapia-domiciliar' },
  { name: 'RPG', href: '/servicos/rpg' },
]
const whatsapp = "https://wa.me/555193408269?text=Olá! Gostaria de saber mais sobre fisioterapia na Cavalhada."
---

<Layout title="Fisioterapia na Cavalhada em Porto Alegre" description="Fisioterapia na Cavalhada, Zona Sul de Porto Alegre. Atendimento especializado próximo ao BarraShoppingSul. Agende sua avaliação.">
  <section class="py-20 px-6 bg-white text-black">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Fisioterapia na Cavalhada em Porto Alegre</h1>
      <p class="text-lg text-gray-600 mb-8 max-w-2xl">Atendimento de fisioterapia na Cavalhada, Zona Sul de Porto Alegre. Tratamento humanizado e próximo de você.</p>
      <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-block bg-lm-pink text-white font-bold py-3 px-8 rounded-full hover:bg-opacity-90 transition-all text-base uppercase tracking-wider">Agende sua avaliação</a>
    </div>
  </section>

  <GoldDivider />

  <section class="py-16 px-6 bg-lm-beige text-black">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold mb-6">Serviços disponíveis na Cavalhada</h2>
      <div class="flex flex-wrap gap-4">
        {services.map(s => (
          <a href={s.href} class="bg-white px-5 py-3 rounded-full font-medium text-sm hover:bg-lm-pink hover:text-white transition-colors border border-gray-200">{s.name}</a>
        ))}
      </div>
      <p class="text-gray-600 mt-8 text-sm">A Cavalhada é um bairro em expansão na Zona Sul de Porto Alegre, próximo ao BarraShoppingSul e com fácil acesso pela Av. Diário de Notícias. Atendemos moradores da região com todo cuidado e dedicação.</p>
    </div>
  </section>

  <GoldDivider />

  <section class="py-16 px-6 bg-white text-black">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold mb-6">Por que escolher nossa clínica?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {['Atendimento individualizado', 'Profissionais especializados', 'Tratamento baseado em evidências', 'Estrutura completa e acolhedora', 'Horários flexíveis', 'Próximo da sua casa'].map(item => (
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-lm-pink shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span class="text-base">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <GoldDivider />

  <section class="py-16 px-6 text-center bg-black text-white">
    <h2 class="text-2xl md:text-3xl font-bold mb-6">Agende sua avaliação na Cavalhada</h2>
    <p class="text-gray-400 mb-8 max-w-lg mx-auto">Entre em contato e marque sua consulta. Cuidamos de você perto da sua casa.</p>
    <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-block bg-lm-pink text-white font-bold py-3 px-8 rounded-full hover:bg-opacity-90 transition-all text-base uppercase tracking-wider">Fale conosco pelo WhatsApp</a>
  </section>
</Layout>
