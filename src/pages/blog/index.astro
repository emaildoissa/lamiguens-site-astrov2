---
import Layout from '@/layouts/Layout.astro'
const posts = [
  { title: 'Quanto Custa Fisioterapia em Porto Alegre?', href: '/blog/quanto-custa-fisioterapia-em-porto-alegre', date: 'Junho 2026', desc: 'Valores de sessões, convênios e pacotes na Zona Sul.' },
  { title: 'Quando Procurar Fisioterapia para Dor Lombar', href: '/blog/quando-procurar-fisioterapia-para-dor-lombar', date: 'Junho 2026', desc: 'Sinais de alerta e benefícios do tratamento precoce.' },
  { title: 'Fisioterapia ou RPG: Qual a Diferença', href: '/blog/fisioterapia-ou-rpg-qual-a-diferenca', date: 'Maio 2026', desc: 'Entenda as diferenças e saiba qual escolher.' },
  { title: 'Pilates Terapêutico para Coluna Funciona?', href: '/blog/pilates-terapeutico-para-coluna-funciona', date: 'Maio 2026', desc: 'Benefícios do Pilates no tratamento de dores na coluna.' },
  { title: 'Como Funciona a Fisioterapia Pós-Operatória', href: '/blog/fisioterapia-pos-operatoria-como-funciona', date: 'Junho 2026', desc: 'Etapas, técnicas e prazos da reabilitação pós-cirúrgica.' },
  { title: 'Fisioterapia Domiciliar Vale a Pena?', href: '/blog/fisioterapia-domiciliar-vale-a-pena', date: 'Junho 2026', desc: 'Vantagens, desvantagens e quando escolher o atendimento em casa.' },
  { title: 'Como Escolher uma Fisioterapia na Zona Sul', href: '/blog/melhor-fisioterapia-na-zona-sul-de-porto-alegre', date: 'Maio 2026', desc: 'Dicas para escolher a melhor clínica perto de você.' },
]
---

<Layout title="Blog | Fisioterapia Zona Sul Porto Alegre" description="Blog sobre fisioterapia, pilates e saúde na Zona Sul de Porto Alegre. Dicas e informações para sua saúde.">
  <section class="py-20 px-6 bg-white text-black">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-12">Blog</h1>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {posts.map(post => (
          <a href={post.href} class="group p-6 border border-gray-200 rounded-xl hover:border-lm-pink hover:shadow-lg transition-all">
            <p class="text-xs text-gray-400 uppercase tracking-wider mb-2">{post.date}</p>
            <h2 class="text-xl font-bold mb-2 group-hover:text-lm-pink transition-colors">{post.title}</h2>
            <p class="text-gray-600 text-sm">{post.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
