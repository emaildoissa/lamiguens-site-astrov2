---
import Layout from '@/layouts/Layout.astro'
import GoldDivider from '@/components/GoldDivider.astro'
const whatsapp = "https://wa.me/555193408269?text=Olá! Gostaria de saber mais sobre pilates terapêutico."
---
<Layout title="Pilates Terapêutico na Zona Sul de Porto Alegre" description="Pilates terapêutico na Zona Sul de Porto Alegre. Fortalecimento, alongamento e reabilitação com método Pilates.">
  <section class="py-20 px-6 bg-white text-black"><div class="max-w-4xl mx-auto"><h1 class="text-4xl md:text-5xl font-bold mb-6">Pilates Terapêutico na Zona Sul de Porto Alegre</h1><p class="text-lg text-gray-600 mb-8 max-w-2xl">Método Pilates aplicado à reabilitação e prevenção de lesões, com foco em fortalecimento e consciência corporal.</p><a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-block bg-lm-pink text-white font-bold py-3 px-8 rounded-full hover:bg-opacity-90 transition-all text-base uppercase tracking-wider">Agende sua avaliação</a></div></section>
  <GoldDivider />
  <section class="py-16 px-6 bg-lm-beige text-black"><div class="max-w-4xl mx-auto"><h2 class="text-2xl md:text-3xl font-bold mb-8">Benefícios do Pilates Terapêutico</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-6">{['Fortalecimento do core (abdômen e lombar)', 'Melhora da postura e alinhamento', 'Aumento da flexibilidade e mobilidade', 'Prevenção de lesões', 'Reabilitação de coluna', 'Melhora do equilíbrio e coordenação', 'Redução do estresse', 'Condicionamento físico global'].map(item => (<div class="flex items-center gap-3"><svg class="w-5 h-5 text-lm-pink shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span class="text-base">{item}</span></div>))}</div></div></section>
  <GoldDivider />
  <section class="py-16 px-6 bg-white text-black"><div class="max-w-4xl mx-auto"><h2 class="text-2xl md:text-3xl font-bold mb-6">Modalidades</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-8">{[{ title: 'Pilates no Solo', desc: 'Exercícios realizados no colchonete com pequenos acessórios como bola, faixa elástica e circle.' },{ title: 'Pilates com Aparelhos', desc: 'Utilizamos Reformer, Cadillac e Chair para exercícios com resistência controlada.' }].map(item => (<div class="p-6 border border-gray-200 rounded-lg"><h3 class="text-lg font-bold mb-2">{item.title}</h3><p class="text-gray-600 text-sm">{item.desc}</p></div>))}</div></div></section>
  <section class="py-16 px-6 text-center bg-black text-white"><h2 class="text-2xl md:text-3xl font-bold mb-6">Comece seu Pilates hoje</h2><p class="text-gray-400 mb-8 max-w-lg mx-auto">Agende uma aula experimental e descubra os benefícios do Pilates para sua saúde.</p><a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-block bg-lm-pink text-white font-bold py-3 px-8 rounded-full hover:bg-opacity-90 transition-all text-base uppercase tracking-wider">Fale conosco pelo WhatsApp</a></section>
</Layout>
