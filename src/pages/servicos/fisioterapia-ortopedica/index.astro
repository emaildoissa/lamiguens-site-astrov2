---
import Layout from '@/layouts/Layout.astro'
import GoldDivider from '@/components/GoldDivider.astro'
const neighborhoods = [
  { name: 'Tristeza', href: '/bairros/tristeza' },
  { name: 'Cristal', href: '/bairros/cristal' },
  { name: 'Vila Assunção', href: '/bairros/vila-assuncao' },
  { name: 'Cavalhada', href: '/bairros/cavalhada' },
]
const faqs = [
  { q: 'O que é a fisioterapia ortopédica?', a: 'É uma especialidade que trata disfunções do sistema musculoesquelético, incluindo ossos, articulações, músculos, ligamentos e tendões, usando técnicas manuais e exercícios terapêuticos.' },
  { q: 'Quantas sessões são necessárias?', a: 'O número de sessões varia conforme o quadro clínico. Após a avaliação inicial, traçamos um plano personalizado com estimativa de duração do tratamento.' },
  { q: 'Preciso de encaminhamento médico?', a: 'Não. Você pode agendar diretamente conosco. Após a avaliação, se necessário, podemos solicitar exames de imagem ou entrar em contato com seu médico.' },
  { q: 'Vocês atendem convênios?', a: 'Atendemos particular e convênios. Consulte a lista de convênios pelo WhatsApp.' },
]
const whatsapp = "https://wa.me/555193408269?text=Olá! Gostaria de saber mais sobre fisioterapia ortopédica."
---

<Layout title="Fisioterapia Ortopédica na Zona Sul de Porto Alegre" description="Tratamento especializado para lesões ortopédicas na Zona Sul de Porto Alegre. Agende sua avaliação com nossos fisioterapeutas.">
  <section class="py-20 px-6 bg-white text-black">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Fisioterapia Ortopédica na Zona Sul de Porto Alegre</h1>
      <p class="text-lg text-gray-600 mb-8 max-w-2xl">Tratamento especializado para recuperar sua mobilidade, aliviar dores e prevenir novas lesões musculoskeletal.</p>
      <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-block bg-lm-pink text-white font-bold py-3 px-8 rounded-full hover:bg-opacity-90 transition-all text-base uppercase tracking-wider">Agende sua avaliação</a>
    </div>
  </section>

  <GoldDivider />

  <section class="py-16 px-6 bg-lm-beige text-black">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold mb-8">Para quem é?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {['Dores articulares crônicas', 'Lesões esportivas', 'Pós-operatório ortopédico', 'Lombalgias e cervicalgias', 'Tendinites e bursites', 'Artrose e desgaste articular', 'Hérnia de disco', 'Torções e entorses'].map(item => (
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-lm-pink shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span class="text-base">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <GoldDivider />

  <section class="py-16 px-6 bg-white text-black">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold mb-6">Como funciona o atendimento</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { step: '1', title: 'Avaliação completa', desc: 'Entrevista detalhada, testes ortopédicos e análise biomecânica para identificar a causa do problema.' },
          { step: '2', title: 'Tratamento personalizado', desc: 'Sessões individuais com técnicas de terapia manual, exercícios terapêuticos e recursos eletroterápicos.' },
          { step: '3', title: 'Prevenção e alta', desc: 'Programa de exercícios domiciliares e orientações para prevenir recidivas e manter os resultados.' },
        ].map(item => (
          <div class="text-center p-6">
            <span class="text-4xl font-bold text-lm-gold block mb-4">{item.step}</span>
            <h3 class="text-lg font-bold mb-2">{item.title}</h3>
            <p class="text-gray-600 text-sm">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <GoldDivider />

  <section class="py-16 px-6 bg-lm-beige text-black">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold mb-6">Atendemos neste serviço em:</h2>
      <div class="flex flex-wrap gap-4">
        {neighborhoods.map(n => (
          <a href={n.href} class="bg-white px-5 py-3 rounded-full font-medium text-sm hover:bg-lm-pink hover:text-white transition-colors border border-gray-200">{n.name}</a>
        ))}
      </div>
    </div>
  </section>

  <GoldDivider />

  <section class="py-16 px-6 bg-white text-black">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold mb-8">Dúvidas frequentes</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="group border border-gray-200 rounded-lg">
            <summary class="flex justify-between items-center cursor-pointer p-4 font-medium text-base hover:bg-gray-50">{faq.q}<svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></summary>
            <div class="px-4 pb-4 text-gray-600 text-sm">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-6 text-center bg-black text-white">
    <h2 class="text-2xl md:text-3xl font-bold mb-6">Pronto para começar seu tratamento?</h2>
    <p class="text-gray-400 mb-8 max-w-lg mx-auto">Agende sua avaliação e descubra como podemos ajudar você a voltar a se mover sem dor.</p>
    <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-block bg-lm-pink text-white font-bold py-3 px-8 rounded-full hover:bg-opacity-90 transition-all text-base uppercase tracking-wider">Fale conosco pelo WhatsApp</a>
  </section>
</Layout>
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["Service", "MedicalSpecialty"],
  "name": "Fisioterapia Ortopédica",
  "description": "Tratamento especializado para lesões ortopédicas na Zona Sul de Porto Alegre.",
  "provider": { "@type": "Physiotherapy", "name": "Clínica de Fisioterapia na Zona Sul" },
  "areaServed": [{ "@type": "City", "name": "Porto Alegre" }]
})} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
})} />
