---
import Layout from '@/layouts/Layout.astro'

const whatsapp = "https://wa.me/555193408269?text=Olá! Gostaria de saber mais sobre RPG."

const indications = [
  { name: "Escoliose e hipercifose", icon: "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
  { name: "Dores nas costas crônicas", icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" },
  { name: "Hérnia de disco", icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" },
  { name: "Enxaqueca e cefaleia postural", icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" },
  { name: "Problemas respiratórios", icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" },
  { name: "Dores articulares", icon: "M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0" },
  { name: "Má postura no trabalho", icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" },
  { name: "Lombalgia crônica", icon: "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
]

const process = [
  { num: "01", title: "Avaliação postural", desc: "Análise detalhada da postura em pé, sentado e em movimento para identificar desvios e compensações." },
  { num: "02", title: "Posturas de tratamento", desc: "Séries de alongamentos globais ativos em posições específicas para alongar cadeias musculares encurtadas." },
  { num: "03", title: "Reeducação", desc: "Integração dos ganhos posturais no dia a dia com orientações de exercícios e ajustes ergonômicos." },
]

const neighborhoods = [
  { name: "Tristeza", href: "/bairros/tristeza" },
  { name: "Cristal", href: "/bairros/cristal" },
  { name: "Vila Assunção", href: "/bairros/vila-assuncao" },
  { name: "Cavalhada", href: "/bairros/cavalhada" },
]

const faqs = [
  { q: "O que é RPG?", a: "RPG (Reeducação Postural Global) é um método de fisioterapia que trata desvios posturais através de alongamentos globais e posturas específicas." },
  { q: "Quantas sessões de RPG são necessárias?", a: "Geralmente de 10 a 20 sessões, dependendo do quadro. Os resultados começam a aparecer já nas primeiras sessões." },
  { q: "RPG é melhor que fisioterapia convencional?", a: "São abordagens complementares. A RPG é especialmente eficaz para problemas posturais e dores crônicas, enquanto a fisioterapia convencional trata lesões específicas." },
  { q: "Quais problemas a RPG trata?", a: "Escoliose, hipercifose, dores nas costas, enxaqueca postural, problemas respiratórios e dores articulares de origem postural." },
]
---

<Layout title="RPG na Zona Sul de Porto Alegre | Reeducação Postural Global" description="RPG (Reeducação Postural Global) na Zona Sul de Porto Alegre. Trate desvios posturais, dores crônicas e melhore sua qualidade de vida.">
  <section class="relative min-h-[75vh] flex items-center bg-lm-charcoal text-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px" />
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-lm-pink/5 rounded-full blur-[150px] pointer-events-none" />
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-lm-gold/5 rounded-full blur-[100px] translate-y-1/4 pointer-events-none" />
    <div class="relative z-10 max-w-6xl mx-auto px-6 py-24 w-full">
      <div class="max-w-4xl">
        <div class="flex items-center gap-3 mb-6 lm-hero-sub">
          <span class="h-px w-8 bg-lm-pink" />
          <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Serviço</span>
        </div>
        <h1 class="text-[40px] md:text-[64px] lg:text-[80px] font-serif font-bold leading-[0.95] tracking-tight lm-hero-title">RPG</h1>
        <p class="text-base md:text-lg text-white/40 mt-6 max-w-xl lm-hero-sub">Reeducação Postural Global — método eficaz para corrigir desvios posturais e aliviar dores crônicas. Na Zona Sul de Porto Alegre.</p>
        <div class="flex flex-wrap items-center gap-4 mt-10 lm-hero-cta">
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="lm-btn inline-flex items-center gap-3 bg-lm-pink text-white font-bold py-4 px-8 rounded-full text-base">
            Agendar Avaliação
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="#faq" class="text-sm text-white/30 hover:text-white/60 transition-colors">Dúvidas frequentes →</a>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-8 mt-20 max-w-2xl border-t border-white/5 pt-10">
        <div>
          <span class="text-[32px] md:text-[40px] font-serif font-bold text-lm-pink block leading-none">8</span>
          <span class="text-xs text-white/30 uppercase tracking-wider mt-2 block">Indicações</span>
        </div>
        <div>
          <span class="text-[32px] md:text-[40px] font-serif font-bold text-lm-pink block leading-none">4</span>
          <span class="text-xs text-white/30 uppercase tracking-wider mt-2 block">Bairros atendidos</span>
        </div>
        <div>
          <span class="text-[32px] md:text-[40px] font-serif font-bold text-lm-pink block leading-none">10-20</span>
          <span class="text-xs text-white/30 uppercase tracking-wider mt-2 block">Sessões estimadas</span>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-lm-cream text-black">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-8 bg-lm-pink" />
            <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Indicações</span>
          </div>
          <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Indicações<br class="hidden md:block" />da RPG</h2>
        </div>
        <p class="text-gray-500 max-w-xs text-sm leading-relaxed">A RPG é especialmente eficaz para problemas posturais e dores crônicas de origem musculoesquelética.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
        {indications.map((c) => (
          <div class="group bg-white rounded-xl px-5 py-5 lm-card border border-gray-100/80 flex items-center gap-3 hover:border-lm-pink/20">
            <div class="w-9 h-9 shrink-0 rounded-lg bg-lm-pink/5 flex items-center justify-center group-hover:bg-lm-pink/10 transition-colors">
              <svg class="w-4 h-4 text-lm-pink" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={c.icon}/></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 group-hover:text-lm-pink transition-colors">{c.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-white text-black">
    <div class="max-w-5xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-8 bg-lm-pink" />
            <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Metodologia</span>
          </div>
          <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Como funciona<br class="hidden md:block" />a RPG</h2>
        </div>
        <p class="text-gray-500 max-w-xs text-sm leading-relaxed">Um método global que trata o corpo como um sistema integrado, não apenas sintomas isolados.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {process.map((step, idx) => (
          <div class="relative p-8 rounded-2xl border border-gray-100 bg-lm-cream/50 lm-card hover:border-lm-pink/10">
            <span class="text-[48px] md:text-[64px] font-serif font-bold text-lm-pink/10 leading-none block mb-4">{step.num}</span>
            <h3 class="text-xl font-bold mb-3">{step.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{step.desc}</p>
            {idx < process.length - 1 && (
              <div class="hidden md:block absolute top-1/2 -right-3 text-lm-pink/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-lm-beige text-black">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-8 bg-lm-pink" />
            <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Regiões</span>
          </div>
          <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Atendemos<br class="hidden md:block" />na Zona Sul</h2>
        </div>
        <p class="text-gray-500 max-w-xs text-sm leading-relaxed">Clínicas próximas da sua casa. Atendimento presencial em quatro bairros.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {neighborhoods.map((n) => (
          <a href={n.href} class="group relative bg-white rounded-2xl p-7 lm-card border border-gray-100/80 overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 bg-lm-pink/5 rounded-full -translate-y-1/2 translate-x-1/2 group-hover:scale-150 transition-transform duration-700" />
            <div class="relative z-10">
              <h4 class="text-lg font-bold mb-1 group-hover:text-lm-pink transition-colors">{n.name}</h4>
              <span class="text-xs text-gray-400 uppercase tracking-wider">Zona Sul</span>
              <div class="mt-4 flex items-center gap-1 text-lm-pink text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity">
                <span>Ver serviços</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="py-24 px-6 bg-white text-black">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-16">
        <div class="flex items-center gap-3 mb-4 justify-center">
          <span class="h-px w-8 bg-lm-pink" />
          <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">FAQ</span>
          <span class="h-px w-8 bg-lm-pink" />
        </div>
        <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Dúvidas frequentes</h2>
      </div>
      <div class="space-y-3">
        {faqs.map((faq, idx) => (
          <details class="group rounded-xl border border-gray-100 overflow-hidden transition-all open:border-lm-pink/20 open:shadow-sm">
            <summary class="flex justify-between items-center cursor-pointer px-6 py-5 font-medium text-base text-gray-700 hover:text-lm-pink transition-colors">
              <span class="flex items-center gap-4">
                <span class="w-6 h-6 rounded-full bg-lm-pink/5 flex items-center justify-center text-xs font-bold text-lm-pink shrink-0">{String(idx + 1).padStart(2, "0")}</span>
                {faq.q}
              </span>
              <svg class="w-4 h-4 text-gray-400 transition-transform duration-300 group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 pl-16 text-gray-500 text-sm leading-relaxed">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-28 px-6 bg-lm-pink text-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px" />
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-white/5 rounded-full blur-[100px] pointer-events-none" />
    <div class="relative z-10 max-w-3xl mx-auto text-center">
      <h2 class="text-[32px] md:text-[52px] font-serif font-bold leading-[1.1] mb-6 tracking-tight">Corrija sua<br />postura hoje</h2>
      <p class="text-base md:text-lg text-white/70 mb-10 max-w-md mx-auto">Agende uma avaliação de RPG e descubra como melhorar sua postura e qualidade de vida.</p>
      <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="lm-btn inline-flex items-center gap-3 bg-white text-lm-pink px-8 py-4 rounded-full font-bold text-base hover:shadow-xl hover:shadow-black/15">
        Agendar Avaliação
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>
</Layout>
