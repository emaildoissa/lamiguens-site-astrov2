---
import Layout from '@/layouts/Layout.astro'

import { WHATSAPP } from '@/lib/consts'
const whatsapp = `https://wa.me/${WHATSAPP}?text=Olá! Gostaria de saber mais sobre fisioterapia pós-operatória.`

const indications = [
  { name: "Cirurgia de joelho (LCA, menisco)", icon: "M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" },
  { name: "Prótese de quadril e joelho", icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" },
  { name: "Cirurgia de coluna", icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" },
  { name: "Cirurgia de ombro", icon: "M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0" },
  { name: "Fraturas e fixações", icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
  { name: "Manguito rotador", icon: "M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662" },
  { name: "Cirurgia de tornozelo", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
  { name: "Pós-operatório de hérnia", icon: "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
]

const benefits = [
  { title: "Recuperação mais rápida", desc: "O tratamento adequado acelera o processo de cicatrização e recuperação funcional." },
  { title: "Menos risco de complicações", desc: "A fisioterapia precoce reduz o risco de aderências, trombose e perda de amplitude." },
  { title: "Melhor resultado cirúrgico", desc: "O pós-operatório bem conduzido potencializa o resultado da cirurgia a longo prazo." },
  { title: "Retorno seguro às atividades", desc: "Cada etapa é planejada para que você volte a fazer o que gosta com segurança." },
]

const phases = [
  { num: "01", title: "Fase Inicial", subtitle: "Controle da dor", desc: "Controle da dor e edema, ganho gradual de amplitude de movimento com técnicas manuais leves e crioterapia.", duration: "1–2 semanas" },
  { num: "02", title: "Fase Intermediária", subtitle: "Fortalecimento", desc: "Fortalecimento muscular, propriocepção, equilíbrio e readaptação funcional para atividades do dia a dia.", duration: "3–6 semanas" },
  { num: "03", title: "Fase Final", subtitle: "Retorno", desc: "Treino específico para retorno ao esporte ou trabalho, com correção de padrões e prevenção de novas lesões.", duration: "6+ semanas" },
]

const neighborhoods = [
  { name: "Tristeza", href: "/bairros/tristeza" },
  { name: "Cristal", href: "/bairros/cristal" },
  { name: "Vila Assunção", href: "/bairros/vila-assuncao" },
  { name: "Cavalhada", href: "/bairros/cavalhada" },
]

const faqs = [
  { q: "Quando devo começar a fisioterapia pós-operatória?", a: "O ideal é iniciar nos primeiros dias após a cirurgia, seguindo a liberação do médico. Quanto antes começar, melhor a recuperação funcional." },
  { q: "A fisioterapia dói?", a: "O desconforto é normal durante o processo de recuperação, mas trabalhamos dentro do limite do paciente, respeitando o tempo de cicatrização." },
  { q: "Preciso de encaminhamento médico?", a: "Sim, para o pós-operatório é importante ter a liberação e as orientações do cirurgião para alinharmos o tratamento." },
  { q: "Quanto tempo dura cada sessão?", a: "As sessões duram em média 50 minutos, com atendimento individualizado e acompanhamento contínuo." },
]
---

<Layout title="Fisioterapia Pós-Operatória na Zona Sul de Porto Alegre" description="Recuperação acelerada e segura após cirurgias ortopédicas na Zona Sul de Porto Alegre. Atendimento individualizado com fisioterapeutas especializados.">
  <!-- HERO -->
  <section class="relative min-h-[75vh] flex items-center bg-lm-charcoal text-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px" />
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-lm-pink/5 rounded-full blur-[150px] -translate-y-1/3 translate-x-1/4 pointer-events-none" />
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-lm-gold/5 rounded-full blur-[100px] translate-y-1/4 -translate-x-1/4 pointer-events-none" />
    <div class="relative z-10 max-w-6xl mx-auto px-6 py-24 w-full">
      <div class="max-w-4xl">
        <div class="flex items-center gap-3 mb-6 lm-hero-sub">
          <span class="h-px w-8 bg-lm-pink" />
          <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Serviço</span>
        </div>
        <h1 class="text-[40px] md:text-[64px] lg:text-[80px] font-serif font-bold leading-[0.95] tracking-tight lm-hero-title">Fisioterapia<br />Pós-Operatória</h1>
        <p class="text-base md:text-lg text-white/40 mt-6 max-w-xl lm-hero-sub">Recupere sua mobilidade e volte às suas atividades com segurança após cirurgias ortopédicas. Na Zona Sul de Porto Alegre.</p>
        <div class="flex flex-wrap items-center gap-4 mt-10 lm-hero-cta">
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="lm-btn inline-flex items-center gap-3 bg-lm-pink text-white font-bold py-4 px-8 rounded-full text-base">
            Agendar Avaliação
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="#faq" class="text-sm text-white/30 hover:text-white/60 transition-colors">Dúvidas frequentes →</a>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-8 mt-20 max-w-2xl border-t border-white/5 pt-10">
        <div>
          <span class="text-[32px] md:text-[40px] font-serif font-bold text-lm-pink block leading-none">8</span>
          <span class="text-xs text-white/30 uppercase tracking-wider mt-2 block">Cirurgias atendidas</span>
        </div>
        <div>
          <span class="text-[32px] md:text-[40px] font-serif font-bold text-lm-pink block leading-none">4</span>
          <span class="text-xs text-white/30 uppercase tracking-wider mt-2 block">Bairros atendidos</span>
        </div>
        <div>
          <span class="text-[32px] md:text-[40px] font-serif font-bold text-lm-pink block leading-none">50</span>
          <span class="text-xs text-white/30 uppercase tracking-wider mt-2 block">Minutos por sessão</span>
        </div>
      </div>
    </div>
  </section>

  <!-- INDICATIONS -->
  <section class="py-24 px-6 bg-lm-cream text-black">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-8 bg-lm-pink" />
            <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Indicações</span>
          </div>
          <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Para quais<br class="hidden md:block" />cirurgias?</h2>
        </div>
        <p class="text-gray-500 max-w-xs text-sm leading-relaxed">Atendemos pacientes no pós-operatório das principais cirurgias ortopédicas. Cada caso tem um protocolo específico.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
        {indications.map((c) => (
          <div class="group bg-white rounded-xl px-5 py-5 lm-card border border-gray-100/80 flex items-center gap-3 hover:border-lm-pink/20">
            <div class="w-9 h-9 shrink-0 rounded-lg bg-lm-pink/5 flex items-center justify-center group-hover:bg-lm-pink/10 transition-colors">
              <svg class="w-4 h-4 text-lm-pink" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={c.icon}/></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 group-hover:text-lm-pink transition-colors">{c.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="py-24 px-6 bg-white text-black">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-8 bg-lm-pink" />
            <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Benefícios</span>
          </div>
          <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Por que fazer<br class="hidden md:block" />fisioterapia?</h2>
        </div>
        <p class="text-gray-500 max-w-xs text-sm leading-relaxed">A fisioterapia pós-operatória não é opcional — é parte essencial do sucesso da sua cirurgia.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
        {benefits.map((b) => (
          <div class="bg-lm-cream/80 rounded-2xl p-8 lm-card border border-gray-100/80 hover:border-lm-pink/10">
            <div class="w-10 h-10 rounded-full bg-lm-pink/5 flex items-center justify-center mb-6">
              <svg class="w-5 h-5 text-lm-pink" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="text-base font-bold mb-2">{b.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RECOVERY TIMELINE -->
  <section class="py-24 px-6 bg-lm-beige text-black">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <div class="flex items-center gap-3 mb-4 justify-center">
          <span class="h-px w-8 bg-lm-pink" />
          <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Cronograma</span>
          <span class="h-px w-8 bg-lm-pink" />
        </div>
        <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Etapas da recuperação</h2>
        <p class="text-gray-500 text-sm mt-4 max-w-md mx-auto">Cada fase tem objetivos claros. O tempo varia conforme o tipo de cirurgia e a resposta individual.</p>
      </div>
      <div class="relative">
        <div class="absolute left-1/2 top-0 bottom-0 w-px bg-lm-pink/10 -translate-x-px hidden md:block" />
        <div class="flex flex-col gap-8">
          {phases.map((p, idx) => (
            <div class="relative md:w-[calc(50%-2rem)] md:odd:ml-auto md:even:mr-auto">
              <div class="hidden md:flex absolute top-8 {idx % 2 === 0 ? '-left-[calc(2rem+9px)]' : '-right-[calc(2rem+9px)]'} w-[18px] h-[18px] rounded-full bg-lm-beige border-2 border-lm-pink z-10" />
              <div class="bg-white rounded-2xl p-8 lm-card border border-gray-100/80">
                <div class="flex items-start gap-5">
                  <span class="text-[40px] md:text-[56px] font-serif font-bold text-lm-pink/10 leading-none shrink-0">{p.num}</span>
                  <div class="min-w-0">
                    <div class="flex items-center gap-3 mb-2 flex-wrap">
                      <h3 class="text-xl md:text-2xl font-bold">{p.title}</h3>
                      <span class="text-xs font-medium text-lm-pink bg-lm-pink/5 px-3 py-1 rounded-full">{p.duration}</span>
                    </div>
                    <p class="text-gray-500 text-xs uppercase tracking-wider font-bold mb-2">{p.subtitle}</p>
                    <p class="text-gray-500 text-sm leading-relaxed">{p.desc}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- NEIGHBORHOODS -->
  <section class="py-24 px-6 bg-lm-cream text-black">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-8 bg-lm-pink" />
            <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Regiões</span>
          </div>
          <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Atendemos<br class="hidden md:block" />na Zona Sul</h2>
        </div>
        <p class="text-gray-500 max-w-xs text-sm leading-relaxed">Clínicas próximas da sua casa. Atendimento presencial em quatro bairros.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {neighborhoods.map((n) => (
          <a href={n.href} class="group relative bg-white rounded-2xl p-7 lm-card border border-gray-100/80 overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 bg-lm-pink/5 rounded-full -translate-y-1/2 translate-x-1/2 group-hover:scale-150 transition-transform duration-700" />
            <div class="relative z-10">
              <h4 class="text-lg font-bold mb-1 group-hover:text-lm-pink transition-colors">{n.name}</h4>
              <span class="text-xs text-gray-400 uppercase tracking-wider">Zona Sul</span>
              <div class="mt-4 flex items-center gap-1 text-lm-pink text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity">
                <span>Ver serviços</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-24 px-6 bg-white text-black">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-16">
        <div class="flex items-center gap-3 mb-4 justify-center">
          <span class="h-px w-8 bg-lm-pink" />
          <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">FAQ</span>
          <span class="h-px w-8 bg-lm-pink" />
        </div>
        <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Dúvidas frequentes</h2>
      </div>
      <div class="space-y-3">
        {faqs.map((faq, idx) => (
          <details class="group rounded-xl border border-gray-100 overflow-hidden transition-all open:border-lm-pink/20 open:shadow-sm">
            <summary class="flex justify-between items-center cursor-pointer px-6 py-6 font-medium text-base text-gray-700 hover:text-lm-pink transition-colors">
              <span class="flex items-center gap-4">
                <span class="w-6 h-6 rounded-full bg-lm-pink/5 flex items-center justify-center text-xs font-bold text-lm-pink shrink-0">{String(idx + 1).padStart(2, "0")}</span>
                {faq.q}
              </span>
              <svg class="w-4 h-4 text-gray-400 transition-transform duration-300 group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 pl-16 text-gray-500 text-sm leading-relaxed">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-28 px-6 bg-lm-pink text-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px" />
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-white/5 rounded-full blur-[100px] pointer-events-none" />
    <div class="relative z-10 max-w-3xl mx-auto text-center">
      <h2 class="text-[32px] md:text-[52px] font-serif font-bold leading-[1.1] mb-6 tracking-tight">Sua recuperação<br />começa aqui</h2>
      <p class="text-base md:text-lg text-white/70 mb-10 max-w-md mx-auto">Agende sua avaliação e descubra como podemos ajudar você a se recuperar bem.</p>
      <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="lm-btn inline-flex items-center gap-3 bg-white text-lm-pink px-8 py-4 rounded-full font-bold text-base hover:shadow-xl hover:shadow-black/15">
        Agendar Avaliação
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>
</Layout>
