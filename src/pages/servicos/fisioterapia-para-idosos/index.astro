---
import Layout from '@/layouts/Layout.astro'
import GoldDivider from '@/components/GoldDivider.astro'
const whatsapp = "https://wa.me/555193408269?text=Olá! Gostaria de saber mais sobre fisioterapia para idosos."
---
<Layout title="Fisioterapia para Idosos na Zona Sul de Porto Alegre" description="Fisioterapia para idosos na Zona Sul de Porto Alegre. Tratamento especializado para a terceira idade com carinho e dedicação.">
  <section class="py-20 px-6 bg-white text-black"><div class="max-w-4xl mx-auto"><h1 class="text-4xl md:text-5xl font-bold mb-6">Fisioterapia para Idosos na Zona Sul de Porto Alegre</h1><p class="text-lg text-gray-600 mb-8 max-w-2xl">Atendimento fisioterapêutico especializado para a terceira idade, com foco em mobilidade, equilíbrio e qualidade de vida.</p><a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-block bg-lm-pink text-white font-bold py-3 px-8 rounded-full hover:bg-opacity-90 transition-all text-base uppercase tracking-wider">Agende sua avaliação</a></div></section>
  <GoldDivider />
  <section class="py-16 px-6 bg-lm-beige text-black"><div class="max-w-4xl mx-auto"><h2 class="text-2xl md:text-3xl font-bold mb-8">Benefícios para a terceira idade</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-6">{['Prevenção de quedas', 'Melhora do equilíbrio', 'Fortalecimento muscular', 'Alívio de dores articulares', 'Melhora da mobilidade', 'Independência nas atividades diárias', 'Tratamento de osteoporose', 'Reabilitação pós-fratura'].map(item => (<div class="flex items-center gap-3"><svg class="w-5 h-5 text-lm-pink shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span class="text-base">{item}</span></div>))}</div></div></section>
  <GoldDivider />
  <section class="py-16 px-6 bg-white text-black"><div class="max-w-4xl mx-auto"><h2 class="text-2xl md:text-3xl font-bold mb-6">Diferenciais do atendimento</h2><div class="grid grid-cols-1 md:grid-cols-3 gap-8">{[{ title: 'Atendimento acolhedor', desc: 'Profissionais pacientes e atenciosos, com experiência no trato com a terceira idade.' },{ title: 'Exercícios adaptados', desc: 'Programas de exercícios adequados à capacidade e limitações de cada paciente.' },{ title: 'Atendimento domiciliar', desc: 'Opção de atendimento em casa para quem tem mobilidade reduzida.' }].map(item => (<div class="text-center p-6 border border-gray-200 rounded-lg"><h3 class="text-lg font-bold mb-2">{item.title}</h3><p class="text-gray-600 text-sm">{item.desc}</p></div>))}</div></div></section>
  <section class="py-16 px-6 text-center bg-black text-white"><h2 class="text-2xl md:text-3xl font-bold mb-6">Qualidade de vida na melhor idade</h2><p class="text-gray-400 mb-8 max-w-lg mx-auto">Agende uma avaliação e descubra como podemos ajudar você ou seu familiar a viver melhor.</p><a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-block bg-lm-pink text-white font-bold py-3 px-8 rounded-full hover:bg-opacity-90 transition-all text-base uppercase tracking-wider">Fale conosco pelo WhatsApp</a></section>
</Layout>
