---
import Layout from '@/layouts/Layout.astro'
import GoldDivider from '@/components/GoldDivider.astro'
const relatedServices = [{ name: 'Reabilitação da Coluna', href: '/servicos/reabilitacao-da-coluna' },{ name: 'Fisioterapia Ortopédica', href: '/servicos/fisioterapia-ortopedica' },{ name: 'RPG', href: '/servicos/rpg' }]
const whatsapp = "https://wa.me/555193408269?text=Olá! Gostaria de saber mais sobre tratamento para dor lombar."
---
<Layout title="Fisioterapia para Dor Lombar na Zona Sul de Porto Alegre" description="Tratamento para dor lombar na Zona Sul de Porto Alegre. Alívio da lombalgia com fisioterapia especializada. Agende sua avaliação.">
  <section class="py-20 px-6 bg-white text-black"><div class="max-w-4xl mx-auto"><h1 class="text-4xl md:text-5xl font-bold mb-6">Fisioterapia para Dor Lombar na Zona Sul de Porto Alegre</h1><p class="text-lg text-gray-600 mb-8 max-w-2xl">A dor lombar é uma das queixas mais comuns em todo o mundo. Saiba como a fisioterapia pode ajudar você a se livrar desse incômodo.</p><a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-block bg-lm-pink text-white font-bold py-3 px-8 rounded-full hover:bg-opacity-90 transition-all text-base uppercase tracking-wider">Agende sua avaliação</a></div></section>
  <GoldDivider />
  <section class="py-16 px-6 bg-lm-beige text-black"><div class="max-w-4xl mx-auto"><h2 class="text-2xl md:text-3xl font-bold mb-6">O que é dor lombar?</h2><p class="text-gray-700 mb-6">A lombalgia é a dor localizada na região inferior das costas, podendo ser aguda (súbita) ou crônica (persistente). As causas incluem má postura, sedentarismo, hérnia de disco, sobrecarga muscular e alterações degenerativas da coluna.</p><h3 class="text-xl font-bold mb-4">Sinais de alerta:</h3><div class="grid grid-cols-1 md:grid-cols-2 gap-4">{['Dor na parte inferior das costas','Dificuldade para se levantar','Irradiação para as pernas','Formigamento ou dormência','Rigidez matinal','Piora ao ficar muito tempo sentado'].map(item => (<div class="flex items-center gap-3"><svg class="w-5 h-5 text-lm-pink shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span class="text-base">{item}</span></div>))}</div></div></section>
  <GoldDivider />
  <section class="py-16 px-6 bg-white text-black"><div class="max-w-4xl mx-auto"><h2 class="text-2xl md:text-3xl font-bold mb-6">Tratamentos que podem ajudar</h2><div class="flex flex-wrap gap-4">{relatedServices.map(s => (<a href={s.href} class="bg-lm-beige px-5 py-3 rounded-full font-medium text-sm hover:bg-lm-pink hover:text-white transition-colors border border-gray-200">{s.name}</a>))}</div><p class="text-gray-600 mt-8">O tratamento fisioterapêutico para dor lombar inclui técnicas de terapia manual, exercícios de fortalecimento do core, alongamentos e orientação postural para prevenir recidivas.</p></div></section>
  <section class="py-16 px-6 text-center bg-black text-white"><h2 class="text-2xl md:text-3xl font-bold mb-6">Não deixe a dor lombar limitar sua vida</h2><p class="text-gray-400 mb-8 max-w-lg mx-auto">Agende uma avaliação e descubra o tratamento ideal para sua lombalgia.</p><a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-block bg-lm-pink text-white font-bold py-3 px-8 rounded-full hover:bg-opacity-90 transition-all text-base uppercase tracking-wider">Fale conosco pelo WhatsApp</a></section>
</Layout>
