---
import Layout from '@/layouts/Layout.astro'

import { WHATSAPP } from '@/lib/consts'
const whatsapp = `https://wa.me/${WHATSAPP}?text=Olá! Gostaria de saber mais sobre tratamento para hérnia de disco.`

const symptoms = [
  { name: "Dor na coluna (lombar ou cervical)", icon: "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
  { name: "Dor irradiada para pernas ou braços", icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" },
  { name: "Formigamento ou dormência", icon: "M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0" },
  { name: "Fraqueza muscular", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
  { name: "Dificuldade para andar", icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" },
  { name: "Perda de reflexos", icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
]

const services = [
  { name: "Reabilitação da Coluna", href: "/servicos/reabilitacao-da-coluna" },
  { name: "Fisioterapia Ortopédica", href: "/servicos/fisioterapia-ortopedica" },
  { name: "RPG", href: "/servicos/rpg" },
]

const process = [
  { num: "01", title: "Avaliação da coluna", desc: "Exame clínico e análise postural detalhada para identificar o nível da hérnia e o melhor tratamento conservador." },
  { num: "02", title: "Descompressão e estabilização", desc: "Técnicas de terapia manual, RPG e exercícios de estabilização segmentar para aliviar a compressão do disco." },
  { num: "03", title: "Prevenção e alta", desc: "Programa de exercícios domiciliares e correção postural para evitar a progressão e novas crises." },
]

const neighborhoods = [
  { name: "Tristeza", href: "/bairros/tristeza" },
  { name: "Cristal", href: "/bairros/cristal" },
  { name: "Vila Assunção", href: "/bairros/vila-assuncao" },
  { name: "Cavalhada", href: "/bairros/cavalhada" },
]

const faqs = [
  { q: "Hérnia de disco tem cura sem cirurgia?", a: "Sim. A maioria das hérnias de disco responde bem ao tratamento conservador com fisioterapia, RPG e exercícios específicos." },
  { q: "Quanto tempo dura o tratamento?", a: "O tratamento conservador leva de 8 a 16 semanas, dependendo do tamanho da hérnia e da resposta do paciente." },
  { q: "Preciso fazer ressonância antes de começar?", a: "Na avaliação inicial decidimos se há necessidade de exames de imagem. Muitas vezes iniciamos o tratamento com base no exame clínico." },
  { q: "Vocês atendem convênios?", a: "Atendemos particular e convênios. Consulte a lista de convênios pelo WhatsApp." },
]
---

<Layout title="Fisioterapia para Hérnia de Disco na Zona Sul de Porto Alegre" description="Tratamento para hérnia de disco na Zona Sul de Porto Alegre. Alívio da dor e reabilitação da coluna com fisioterapia especializada.">
  <section class="relative min-h-[70vh] flex items-center bg-lm-charcoal text-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px" />
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-lm-pink/5 rounded-full blur-[150px] pointer-events-none" />
    <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-lm-gold/5 rounded-full blur-[100px] translate-y-1/4 pointer-events-none" />
    <div class="relative z-10 max-w-6xl mx-auto px-6 py-20 w-full">
      <div class="max-w-4xl">
        <div class="flex items-center gap-3 mb-6 lm-hero-sub">
          <span class="h-px w-8 bg-lm-pink" />
          <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Condição</span>
        </div>
        <h1 class="text-[40px] md:text-[64px] lg:text-[80px] font-serif font-bold leading-[0.95] tracking-tight lm-hero-title">Hérnia de Disco</h1>
        <p class="text-base md:text-lg text-white/40 mt-6 max-w-xl lm-hero-sub">Tratamento conservador para hérnia de disco na Zona Sul de Porto Alegre. Alívio da dor sem cirurgia.</p>
        <div class="flex flex-wrap items-center gap-4 mt-10 lm-hero-cta">
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="lm-btn inline-flex items-center gap-3 bg-lm-pink text-white font-bold py-4 px-8 rounded-full text-base">
            Agendar Avaliação
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="#faq" class="text-sm text-white/30 hover:text-white/60 transition-colors">Dúvidas frequentes →</a>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-8 mt-16 max-w-2xl border-t border-white/5 pt-10">
        <div>
          <span class="text-[32px] md:text-[40px] font-serif font-bold text-lm-pink block leading-none">6</span>
          <span class="text-xs text-white/30 uppercase tracking-wider mt-2 block">Sintomas tratados</span>
        </div>
        <div>
          <span class="text-[32px] md:text-[40px] font-serif font-bold text-lm-pink block leading-none">3</span>
          <span class="text-xs text-white/30 uppercase tracking-wider mt-2 block">Serviços indicados</span>
        </div>
        <div>
          <span class="text-[32px] md:text-[40px] font-serif font-bold text-lm-pink block leading-none">4</span>
          <span class="text-xs text-white/30 uppercase tracking-wider mt-2 block">Bairros atendidos</span>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-lm-cream text-black lm-reveal">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-8 bg-lm-pink" />
            <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Sintomas</span>
          </div>
          <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Sintomas comuns<br class="hidden md:block" />da hérnia de disco</h2>
        </div>
        <p class="text-gray-500 max-w-xs text-sm leading-relaxed">A hérnia de disco pode causar desde dor localizada até sintomas neurológicos.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
        {symptoms.map((s) => (
          <div class="group bg-white rounded-xl px-5 py-5 lm-card border border-gray-100/80 flex items-center gap-3 hover:border-lm-pink/20">
            <div class="w-9 h-9 shrink-0 rounded-lg bg-lm-pink/5 flex items-center justify-center group-hover:bg-lm-pink/10 transition-colors">
              <svg class="w-4 h-4 text-lm-pink" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={s.icon}/></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 group-hover:text-lm-pink transition-colors">{s.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-white text-black lm-reveal">
    <div class="max-w-5xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-8 bg-lm-pink" />
            <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Tratamentos</span>
          </div>
          <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Serviços que<br class="hidden md:block" />podem ajudar</h2>
        </div>
        <p class="text-gray-500 max-w-xs text-sm leading-relaxed">Tratamento conservador para hérnia de disco com diferentes abordagens especializadas.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {services.map((s, idx) => (
          <a href={s.href} class="group relative p-8 rounded-2xl border border-gray-100 bg-lm-cream/50 lm-card hover:border-lm-pink/10 block">
            <span class="text-[48px] md:text-[64px] font-serif font-bold text-lm-pink/10 leading-none block mb-4">{String(idx + 1).padStart(2, "0")}</span>
            <h3 class="text-xl font-bold mb-3 group-hover:text-lm-pink transition-colors">{s.name}</h3>
            <div class="mt-6 flex items-center gap-1 text-lm-pink text-sm font-medium">
              <span>Saiba mais</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-lm-beige text-black lm-reveal">
    <div class="max-w-5xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-8 bg-lm-pink" />
            <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Metodologia</span>
          </div>
          <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Como tratamos<br class="hidden md:block" />a hérnia de disco</h2>
        </div>
        <p class="text-gray-500 max-w-xs text-sm leading-relaxed">Abordagem conservadora completa, da avaliação à prevenção de novas crises.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {process.map((step, idx) => (
          <div class="relative p-8 rounded-2xl border border-gray-100 bg-white lm-card hover:border-lm-pink/10">
            <span class="text-[48px] md:text-[64px] font-serif font-bold text-lm-pink/10 leading-none block mb-4">{step.num}</span>
            <h3 class="text-xl font-bold mb-3">{step.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{step.desc}</p>
            {idx < process.length - 1 && (
              <div class="hidden md:block absolute top-1/2 -right-3 text-lm-pink/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-lm-cream text-black lm-reveal">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="h-px w-8 bg-lm-pink" />
            <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">Regiões</span>
          </div>
          <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Atendemos<br class="hidden md:block" />na Zona Sul</h2>
        </div>
        <p class="text-gray-500 max-w-xs text-sm leading-relaxed">Clínicas próximas da sua casa. Atendimento presencial em quatro bairros.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {neighborhoods.map((n) => (
          <a href={n.href} class="group relative bg-white rounded-2xl p-7 lm-card border border-gray-100/80 overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 bg-lm-pink/5 rounded-full -translate-y-1/2 translate-x-1/2 group-hover:scale-150 transition-transform duration-700" />
            <div class="relative z-10">
              <h4 class="text-lg font-bold mb-1 group-hover:text-lm-pink transition-colors">{n.name}</h4>
              <span class="text-xs text-gray-400 uppercase tracking-wider">Zona Sul</span>
              <div class="mt-4 flex items-center gap-1 text-lm-pink text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity">
                <span>Ver serviços</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="py-24 px-6 bg-white text-black lm-reveal">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-16">
        <div class="flex items-center gap-3 mb-4 justify-center">
          <span class="h-px w-8 bg-lm-pink" />
          <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.25em]">FAQ</span>
          <span class="h-px w-8 bg-lm-pink" />
        </div>
        <h2 class="text-[32px] md:text-[44px] font-serif font-bold tracking-tight">Dúvidas frequentes</h2>
      </div>
      <div class="space-y-3">
        {faqs.map((faq, idx) => (
          <details class="group rounded-xl border border-gray-100 overflow-hidden transition-all open:border-lm-pink/20 open:shadow-sm">
            <summary class="flex justify-between items-center cursor-pointer px-6 py-5 font-medium text-base text-gray-700 hover:text-lm-pink transition-colors">
              <span class="flex items-center gap-4">
                <span class="w-6 h-6 rounded-full bg-lm-pink/5 flex items-center justify-center text-xs font-bold text-lm-pink shrink-0">{String(idx + 1).padStart(2, "0")}</span>
                {faq.q}
              </span>
              <svg class="w-4 h-4 text-gray-400 transition-transform duration-300 group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 pl-16 text-gray-500 text-sm leading-relaxed">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-28 px-6 bg-lm-pink text-white overflow-hidden lm-reveal">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px" />
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-white/5 rounded-full blur-[100px] pointer-events-none" />
    <div class="relative z-10 max-w-3xl mx-auto text-center">
      <h2 class="text-[32px] md:text-[52px] font-serif font-bold leading-[1.1] mb-6 tracking-tight">Pronto para tratar<br />sua hérnia de disco?</h2>
      <p class="text-base md:text-lg text-white/70 mb-10 max-w-md mx-auto">Agende sua avaliação e descubra o tratamento conservador ideal para sua hérnia de disco.</p>
      <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="lm-btn inline-flex items-center gap-3 bg-white text-lm-pink px-8 py-4 rounded-full font-bold text-base hover:shadow-xl hover:shadow-black/15">
        Agendar Avaliação
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>
</Layout>
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["MedicalWebPage", "MedicalCondition"],
  "name": "Hérnia de Disco - Fisioterapia na Zona Sul",
  "description": "Tratamento para hérnia de disco na Zona Sul de Porto Alegre com fisioterapia especializada."
})} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
})} />
