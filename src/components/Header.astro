---
const services = [
  { label: 'Fisioterapia Ortopédica', href: '/servicos/fisioterapia-ortopedica' },
  { label: 'Fisioterapia Pós-Operatória', href: '/servicos/fisioterapia-pos-operatoria' },
  { label: 'Fisioterapia Domiciliar', href: '/servicos/fisioterapia-domiciliar' },
  { label: 'RPG', href: '/servicos/rpg' },
  { label: 'Pilates Terapêutico', href: '/servicos/pilates-terapeutico' },
  { label: 'Fisioterapia Esportiva', href: '/servicos/fisioterapia-esportiva' },
  { label: 'Reabilitação da Coluna', href: '/servicos/reabilitacao-da-coluna' },
  { label: 'Acupuntura', href: '/servicos/acupuntura' },
]
---

<header id="lm-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-5">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="lm-glass rounded-2xl px-6 py-3 flex justify-between items-center border border-white/20 shadow-lg shadow-black/5">
      <a href="/" class="flex items-center shrink-0">
        <span class="font-serif text-2xl md:text-3xl font-bold text-lm-dark tracking-tight">Fisio<span class="text-lm-pink">Zona</span>Sul</span>
      </a>
      <div class="md:hidden">
        <button id="mobile-menu-btn" class="text-lm-dark hover:text-lm-pink rounded-md p-2 transition-colors" aria-label="Abrir menu">
          <svg id="menu-icon-bars" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <nav class="hidden md:block">
        <ul class="flex items-center gap-1 text-sm font-medium tracking-wide">
          <li><a href="/" class="lm-nav-link px-3 py-2 text-lm-dark hover:text-lm-pink transition-colors rounded-lg">Home</a></li>
          <li><a href="/como-funciona" class="lm-nav-link px-3 py-2 text-lm-dark hover:text-lm-pink transition-colors rounded-lg">Como Funciona</a></li>
          <li class="relative group">
            <button id="desktop-services-btn" class="lm-nav-link px-3 py-2 text-lm-dark hover:text-lm-pink transition-colors rounded-lg flex items-center gap-1 cursor-pointer" aria-haspopup="true" aria-expanded="false">
              Serviços<svg class="w-3 h-3 mt-0.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 hidden group-hover:block group-focus-within:block z-50" role="region" aria-label="Serviços">
              <div class="lm-glass rounded-xl border border-gray-100/50 shadow-xl shadow-black/5 py-2 w-56">
                {services.map((s) => (<a href={s.href} class="block px-4 py-2.5 text-sm text-gray-700 hover:text-lm-pink hover:bg-lm-beige/50 transition-all">{s.label}</a>))}
              </div>
            </div>
          </li>
          <li><a href="/blog" class="lm-nav-link px-3 py-2 text-lm-dark hover:text-lm-pink transition-colors rounded-lg">Blog</a></li>
          <li><a href="/bairros" class="lm-nav-link px-3 py-2 text-lm-dark hover:text-lm-pink transition-colors rounded-lg">Regiões</a></li>
          <li><a href="/contato" class="ml-2 bg-lm-pink text-white px-5 py-2.5 rounded-full font-bold text-sm hover:bg-opacity-90 transition-all hover:shadow-lg hover:shadow-lm-pink/25">Contato</a></li>
        </ul>
      </nav>
    </div>
  </div>
  <nav id="mobile-menu" class="hidden md:hidden container mx-auto px-4 sm:px-6 lg:px-8 mt-2">
    <div class="lm-glass rounded-2xl border border-white/20 shadow-lg py-4 px-6">
      <ul class="flex flex-col gap-1">
        <li><a class="mobile-link block px-4 py-2.5 text-sm text-gray-700 hover:text-lm-pink hover:bg-lm-beige/50 rounded-lg transition-all" href="/">Home</a></li>
        <li><a class="mobile-link block px-4 py-2.5 text-sm text-gray-700 hover:text-lm-pink hover:bg-lm-beige/50 rounded-lg transition-all" href="/como-funciona">Como Funciona</a></li>
        <li><button id="mobile-services-btn" class="flex justify-between w-full px-4 py-2.5 text-sm text-gray-700 hover:text-lm-pink hover:bg-lm-beige/50 rounded-lg transition-all items-center cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-controls="mobile-services-submenu">Serviços<svg id="services-chevron" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></button></li>
        <ul id="mobile-services-submenu" class="hidden ml-4 flex flex-col gap-1 border-l-2 border-lm-pink/20 pl-4">
          {services.map((s) => (<li><a href={s.href} class="mobile-link block px-4 py-2 text-sm text-gray-600 hover:text-lm-pink rounded-lg transition-all">{s.label}</a></li>))}
        </ul>
        <li><a class="mobile-link block px-4 py-2.5 text-sm text-gray-700 hover:text-lm-pink hover:bg-lm-beige/50 rounded-lg transition-all" href="/blog">Blog</a></li>
        <li><a class="mobile-link block px-4 py-2.5 text-sm text-gray-700 hover:text-lm-pink hover:bg-lm-beige/50 rounded-lg transition-all" href="/bairros">Regiões</a></li>
        <li><a class="mobile-link block px-4 py-2.5 text-sm text-lm-pink font-bold hover:bg-lm-pink/5 rounded-lg transition-all" href="/contato">Contato</a></li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('lm-header');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconBars = document.getElementById('menu-icon-bars');
  const iconClose = document.getElementById('menu-icon-close');
  const servicesBtn = document.getElementById('mobile-services-btn');
  const servicesSubmenu = document.getElementById('mobile-services-submenu');
  const servicesChevron = document.getElementById('services-chevron');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  function handleScroll() {
    const y = window.scrollY;
    if (!header) return;
    if (y > 20) { header.classList.add('shadow-sm'); header.querySelector('.lm-glass')?.classList.add('bg-white/90'); }
    else { header.classList.remove('shadow-sm'); header.querySelector('.lm-glass')?.classList.remove('bg-white/90'); }
  }
  window.addEventListener('scroll', handleScroll, { passive: true });

  function toggleMobileMenu(open?: boolean) {
    const isOpen = open ?? mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden', !isOpen);
    iconBars?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
    mobileBtn?.setAttribute('aria-expanded', String(!!isOpen));
    mobileBtn?.setAttribute('aria-label', isOpen ? 'Fechar menu' : 'Abrir menu');
  }
  function toggleMobileSubmenu(open?: boolean) {
    const isOpen = open ?? servicesSubmenu?.classList.contains('hidden');
    servicesSubmenu?.classList.toggle('hidden', !isOpen);
    servicesSubmenu?.classList.toggle('flex', !!isOpen);
    servicesChevron?.classList.toggle('rotate-180', !!isOpen);
    servicesBtn?.setAttribute('aria-expanded', String(!!isOpen));
  }
  mobileBtn?.addEventListener('click', () => toggleMobileMenu());
  servicesBtn?.addEventListener('click', () => toggleMobileSubmenu());
  mobileLinks.forEach((link) => link.addEventListener('click', () => toggleMobileMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (mobileMenu && !mobileMenu.classList.contains('hidden')) { toggleMobileMenu(false); mobileBtn?.focus(); }
      if (servicesSubmenu && !servicesSubmenu.classList.contains('hidden')) { toggleMobileSubmenu(false); servicesBtn?.focus(); }
    }
  });
</script>
