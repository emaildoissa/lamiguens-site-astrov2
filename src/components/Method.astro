---
const steps = [
  { number: "1.", title: "DECREASE PAIN.", description: "Pain is a message, not a stop sign. We help you understand what your body is telling you and work to alleviate discomfort through targeted manual therapy and movement education.", image: "/images/assets/67e7fb372378bc60f16a6764_Decrease_20pain.avif" },
  { number: "2.", title: "ALIGN.", description: "Daily habits, past injuries, and repetitive movements create imbalances. We help you realign your body so it can function the way it was designed to.", image: "/images/assets/67e7fb3707a3735f880b0512_Align.avif" },
  { number: "3.", title: "LEARN TO MOVE.", description: "Smart movement is about making your body work for you, not against you. We teach you how to move efficiently and safely in everyday life.", image: "/images/assets/67e7fb37c22904b2b27ec8be_Learn_20to_20move.avif" },
  { number: "4.", title: "BUILD STRENGTH.", description: "Strength isn't just about power—it's about resilience. We build your strength from the ground up so you can do what you love for longer.", image: "/images/assets/67e7fb38b14405c330608974_Build_20strength.avif" },
  { number: "5.", title: "MOVE WITH PURPOSE.", description: "You were born to move. We help you rediscover the joy of movement and build habits that keep you active for life.", image: "/images/assets/67e7fb374bb6437fb00c52f6_Move_20with_20purpose.avif" },
]
---

<section class="bg-black text-white py-20 px-6 md:px-12">
  <div class="max-w-7xl mx-auto">
    <div class="mb-16 md:mb-24">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">FutureProof Method™</h2>
      <p class="text-lg md:text-xl text-white/80 max-w-2xl">FutureProof™ is our proprietary way of giving you the tools to move more powerfully, so you can do what you love for longer. Here's how it works.</p>
    </div>
    <div class="flex flex-col gap-20 md:gap-32">
      {steps.map((step, index) => (
        <div class="flex flex-col md:flex-row items-center gap-10 md:gap-24 {index % 2 === 1 ? 'md:flex-row-reverse' : ''}">
          <div class="flex-1 w-full">
            <div class="relative aspect-square overflow-hidden rounded-2xl">
              <img src={step.image} alt={step.title} class="absolute inset-0 w-full h-full object-cover" />
            </div>
          </div>
          <div class="flex-1 flex flex-col justify-center">
            <span class="text-base font-bold mb-2 tracking-wider">{step.number}</span>
            <h3 class="text-3xl md:text-4xl font-bold uppercase mb-6 tracking-tight">{step.title}</h3>
            <p class="text-base md:text-lg leading-relaxed text-white/70">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
