---
const neighborhoods = [
  { name: "Tristeza", desc: "Bairro tradicional da Zona Sul", services: ["Fisioterapia Ortopédica", "Fisioterapia Domiciliar", "RPG"], href: "/bairros/tristeza" },
  { name: "Cristal", desc: "Próximo ao Shopping Zona Sul", services: ["Fisioterapia Ortopédica", "Fisioterapia Pós-Operatória", "Pilates"], href: "/bairros/cristal" },
  { name: "Vila Assunção", desc: "Bairro nobre e arborizado", services: ["Fisioterapia Ortopédica", "RPG", "Fisioterapia Domiciliar"], href: "/bairros/vila-assuncao" },
  { name: "Cavalhada", desc: "Próximo ao BarraShoppingSul", services: ["Fisioterapia Pós-Operatória", "Fisioterapia Domiciliar", "RPG"], href: "/bairros/cavalhada" },
]
const whatsapp = "https://wa.me/555193408269?text=Olá! Gostaria de mais informações sobre a clínica."
---

<section class="bg-lm-beige text-black py-20 px-6 md:px-12">
  <div class="max-w-7xl mx-auto">
    <div class="mb-12">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">Atendemos na Zona Sul</h2>
      <p class="text-xl opacity-70">Encontre o bairro mais próximo de você.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {neighborhoods.map((n) => (
        <a href={n.href} class="flex flex-col gap-4 p-8 bg-white border border-[#E5E5E5] rounded-xl hover:border-lm-pink hover:shadow-lg transition-all group">
          <div>
            <h4 class="text-xl font-bold mb-1 group-hover:text-lm-pink transition-colors">{n.name}</h4>
            <span class="text-xs font-bold uppercase tracking-wider text-black/50">{n.desc}</span>
          </div>
          <div class="flex flex-wrap gap-2 mt-auto">
            {n.services.map(s => (
              <span class="text-[10px] uppercase tracking-wider px-2 py-1 bg-lm-beige rounded-full font-medium">{s}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
    <div class="text-center mt-12">
      <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex bg-black text-white px-8 py-4 rounded-full font-bold text-base hover:bg-black/90 transition-colors uppercase tracking-wide">AGENDE SUA AVALIAÇÃO</a>
    </div>
  </div>
</section>
