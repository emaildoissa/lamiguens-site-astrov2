---
const marqueeItems = [
  "Fisioterapia Ortopédica", "Pilates Terapêutico", "RPG", "Fisioterapia Esportiva",
  "Fisioterapia Domiciliar", "Reabilitação da Coluna", "Neuromodulação", "Acupuntura",
  "Fisioterapia Pós-Operatória", "Fisioterapia para Idosos",
]
---

<section class="relative bg-lm-charcoal text-white py-5 overflow-hidden border-t border-white/5">
  <div class="flex whitespace-nowrap">
    <div class="flex gap-12 items-center animate-marquee shrink-0">
      {marqueeItems.map((item) => (
        <div class="flex items-center gap-12 shrink-0">
          <span class="text-sm font-bold uppercase tracking-[0.15em] text-white/80">{item}</span>
          <span class="w-1 h-1 bg-lm-pink rounded-full shrink-0 opacity-60" />
        </div>
      ))}
      {marqueeItems.map((item) => (
        <div class="flex items-center gap-12 shrink-0">
          <span class="text-sm font-bold uppercase tracking-[0.15em] text-white/80">{item}</span>
          <span class="w-1 h-1 bg-lm-pink rounded-full shrink-0 opacity-60" />
        </div>
      ))}
    </div>
  </div>
</section>
