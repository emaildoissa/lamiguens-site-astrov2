---
const marqueeItems = [
  "AT MYO, WE MAKE SENSE OF THE BODY",
  "Improve Mobility",
  "Shoulder Pain",
  "Chronic Pain Relief",
  "Knee Injuries",
  "Myofascial Release",
  "Injury Prevention",
]
---

<section class="bg-black text-white py-4 overflow-hidden whitespace-nowrap flex border-y border-white/10">
  <div class="flex gap-8 items-center animate-marquee shrink-0">
    {marqueeItems.map((item) => (
      <div class="flex items-center gap-8 shrink-0">
        <span class="text-base font-bold uppercase tracking-[0.05em]">{item}</span>
        <span class="w-1.5 h-1.5 bg-white rounded-full shrink-0" />
      </div>
    ))}
    {marqueeItems.map((item) => (
      <div class="flex items-center gap-8 shrink-0">
        <span class="text-base font-bold uppercase tracking-[0.05em]">{item}</span>
        <span class="w-1.5 h-1.5 bg-white rounded-full shrink-0" />
      </div>
    ))}
  </div>
</section>
