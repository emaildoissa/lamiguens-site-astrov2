---
const testimonials = [
  { quote: "\"Excelente atendimento! Cheguei com muitas dores nas costas e depois de algumas sessões já senti uma melhora incrível. Profissionais muito capacitados.\"", author: "MARIA S.", date: "MAIO 2026" },
  { quote: "\"Fiz tratamento de RPG e o resultado superou minhas expectativas. Ambiente acolhedor e equipe muito atenciosa.\"", author: "CARLOS M.", date: "ABRIL 2026" },
  { quote: "\"A fisioterapia domiciliar foi essencial para minha recuperação pós-cirúrgica. Profissionais pontuais e extremamente competentes.\"", author: "ANA P.", date: "MARÇO 2026" },
  { quote: "\"Finalmente encontrei uma clínica que entende de fisioterapia esportiva. Voltei a correr sem dor depois do tratamento.\"", author: "PEDRO L.", date: "JUNHO 2026" },
  { quote: "\"Ambiente agradável, profissionais atenciosos e tratamento personalizado. A diferença está no cuidado com cada paciente.\"", author: "JULIANA R.", date: "FEVEREIRO 2026" },
]
---

<section class="bg-white text-black py-20 px-6 md:px-12">
  <div class="max-w-5xl mx-auto flex flex-col items-center text-center">
    <h3 class="text-sm font-bold tracking-[0.2em] uppercase mb-12 text-black/60">DEPOIMENTOS</h3>
    <div class="relative w-full overflow-hidden mb-8 min-h-[300px] flex items-center">
      {testimonials.map((testimonial, index) => (
        <div key={index} data-slide={index} class="testimonial-slide absolute inset-0 flex flex-col items-center justify-center transition-all duration-700 ease-in-out {index === 0 ? 'opacity-100 translate-x-0 scale-100' : 'opacity-0 -translate-x-full scale-95'}">
          <blockquote class="text-2xl md:text-3xl lg:text-4xl font-medium mb-10 max-w-4xl leading-tight">{testimonial.quote}</blockquote>
          <div class="flex flex-col items-center">
            <span class="text-sm font-bold tracking-widest mb-1">{testimonial.author}</span>
            <span class="text-xs font-bold text-black/40 tracking-widest">{testimonial.date}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="flex flex-col items-center gap-2 mb-12">
      <div class="flex gap-0.5">
        {[...Array(5)].map((_) => (
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="text-lm-gold"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        ))}
      </div>
      <p class="text-sm text-black/60 font-medium">Avaliação: <span class="text-black">4.9 de 5</span>, baseado em mais de 200 avaliações</p>
    </div>
    <div class="flex gap-4">
      <button id="testimonial-prev" class="w-12 h-12 rounded-full border border-black/10 flex items-center justify-center hover:bg-black hover:text-white transition-colors group">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-active:scale-90 transition-transform"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button id="testimonial-next" class="w-12 h-12 rounded-full border border-black/10 flex items-center justify-center hover:bg-black hover:text-white transition-colors group">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-active:scale-90 transition-transform"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
    <div id="testimonial-dots" class="flex gap-2 mt-8">
      {testimonials.map((_, index) => (
        <button key={index} data-dot={index} class="testimonial-dot w-1.5 h-1.5 rounded-full transition-all {index === 0 ? 'bg-black w-4' : 'bg-black/20'}" aria-label="Ir para slide {index + 1}"></button>
      ))}
    </div>
  </div>
</section>

<script>
  const slides = document.querySelectorAll('.testimonial-slide');
  const dots = document.querySelectorAll('.testimonial-dot');
  let currentIndex = 0;

  function goToSlide(index) {
    slides.forEach((slide, i) => {
      slide.classList.remove('opacity-100', 'translate-x-0', 'scale-100');
      slide.classList.add('opacity-0');
      if (i < index) {
        slide.classList.remove('translate-x-full');
        slide.classList.add('-translate-x-full', 'scale-95');
      } else if (i > index) {
        slide.classList.remove('-translate-x-full');
        slide.classList.add('translate-x-full', 'scale-95');
      }
    });
    slides[index].classList.remove('opacity-0', '-translate-x-full', 'translate-x-full', 'scale-95');
    slides[index].classList.add('opacity-100', 'translate-x-0', 'scale-100');

    dots.forEach((dot, i) => {
      dot.classList.remove('bg-black', 'w-4');
      dot.classList.add('bg-black/20', 'w-1.5');
      if (i === index) {
        dot.classList.remove('bg-black/20', 'w-1.5');
        dot.classList.add('bg-black', 'w-4');
      }
    });
    currentIndex = index;
  }

  function next() { goToSlide((currentIndex + 1) % slides.length); }
  function prev() { goToSlide((currentIndex - 1 + slides.length) % slides.length); }

  document.getElementById('testimonial-prev')?.addEventListener('click', prev);
  document.getElementById('testimonial-next')?.addEventListener('click', next);
  dots.forEach(dot => dot.addEventListener('click', () => goToSlide(parseInt(dot.dataset.dot))));
</script>
