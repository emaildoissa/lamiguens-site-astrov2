---
const testimonials = [
  { quote: "Excelente atendimento! Cheguei com muitas dores nas costas e depois de algumas sessões já senti uma melhora incrível. Profissionais muito capacitados.", author: "Maria S.", date: "MAIO 2026" },
  { quote: "Fiz tratamento de RPG e o resultado superou minhas expectativas. Ambiente acolhedor e equipe muito atenciosa.", author: "Carlos M.", date: "ABRIL 2026" },
  { quote: "A fisioterapia domiciliar foi essencial para minha recuperação pós-cirúrgica. Profissionais pontuais e extremamente competentes.", author: "Ana P.", date: "MARÇO 2026" },
  { quote: "Finalmente encontrei uma clínica que entende de fisioterapia esportiva. Voltei a correr sem dor depois do tratamento.", author: "Pedro L.", date: "JUNHO 2026" },
  { quote: "Ambiente agradável, profissionais atenciosos e tratamento personalizado. A diferença está no cuidado com cada paciente.", author: "Juliana R.", date: "FEVEREIRO 2026" },
]
---

<section class="py-24 px-6 bg-lm-beige text-black lm-reveal">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <span class="text-xs text-lm-pink font-bold uppercase tracking-[0.2em] mb-4 block">Depoimentos</span>
      <h2 class="text-[32px] md:text-[48px] font-serif font-bold tracking-tight">O que nossos pacientes dizem</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.map((t, i) => (
        <div key={i} class="bg-white p-8 rounded-2xl lm-card border border-gray-100">
          <div class="flex gap-1 mb-4">
            {[...Array(5)].map(_ => (<svg width="14" height="14" viewBox="0 0 24 24" fill="var(--color-lm-gold)" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>))}
          </div>
          <blockquote class="text-sm leading-relaxed text-gray-600 mb-6">"{t.quote}"</blockquote>
          <div class="flex items-center justify-between pt-4 border-t border-gray-100">
            <span class="text-sm font-bold">{t.author}</span>
            <span class="text-xs text-gray-400">{t.date}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="text-center mt-10">
      <p class="text-sm text-gray-500">Avaliação <span class="text-lm-gold font-bold">4.9</span> de 5 — baseado em mais de 200 avaliações</p>
    </div>
  </div>
</section>
